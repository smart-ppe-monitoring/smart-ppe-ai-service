# Environment variables — copy to .env and fill in values
# NEVER commit .env to version control

# ─── Backend & Microservices M2M ─────────────────────────────────────────────
BACKEND_BASE_URL=http://localhost:8893
CAMERA_SERVICE_URL=http://localhost:8892
SITE_SERVICE_URL=http://localhost:8891
REPORTING_SERVICE_URL=http://localhost:8894
IDENTITY_SERVICE_URL=http://localhost:9999
AUTH_JWKS_URL=http://localhost:9999/.well-known/jwks.json
JWT_PUBLIC_KEY_PATH=keys/public.key.pem
INTERNAL_SERVICE_TOKEN=smart_ppe_internal_service_token_change_me_32chars
GATEWAY_INTERNAL_SECRET=

# ─── Live Production Engine & 24/7 Sync ──────────────────────────────────────
LIVE_MAX_SESSIONS=16
LIVE_DISPATCH_ENABLED=true
AI_AUTO_SYNC_ENABLED=true
AI_CAMERA_SYNC_INTERVAL_S=15
AI_TELEMETRY_ENABLED=true
AI_TELEMETRY_PUSH_INTERVAL_S=30
AI_ALLOWED_HOSTS=127.0.0.1,localhost,ai-service
LIVE_ALLOWED_RTSP_HOSTS=
LIVE_ALLOW_HTTP_STREAMS=false

# ─── Kafka ────────────────────────────────────────────────────────────────────
KAFKA_ENABLED=false
KAFKA_BROKER=localhost:9092

# ─── MinIO ────────────────────────────────────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minio_admin
MINIO_SECRET_KEY=             # fill in your secret — never log this value
MINIO_SECURE=false
MINIO_BUCKET=ppe-evidences

# ─── Safety Rules fallback (overridden dynamically from Backend API) ──────────
CONFIDENCE_THRESHOLD=0.8
CONFIRMATION_DURATION_S=2
COOLDOWN_DURATION_S=30

# ─── Model ────────────────────────────────────────────────────────────────────
YOLO_MODEL_PATH=models/yolo11s-best.pt
MODEL_IMGSZ=640
DEVICE=
